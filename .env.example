# Copy to .env and adjust. All variables are prefixed GREYBOX_.

GREYBOX_QDRANT_URL=http://qdrant:6333
GREYBOX_REDIS_URL=redis://redis:6379

GREYBOX_QDRANT_COLLECTION=greybox_kb

GREYBOX_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

GREYBOX_CACHE_TTL_SECONDS=3600

GREYBOX_DRIFT_THRESHOLD=0.15

# Chunking (word-based; ~tokens)
GREYBOX_CHUNK_SIZE=500
GREYBOX_CHUNK_OVERLAP=100

GREYBOX_DATA_DIR=/data
GREYBOX_BASELINE_CENTROID_PATH=/data/baseline_centroid.npy

# --- LLM answer generation (optional) ---
# llm_provider: ollama | openai | none
GREYBOX_LLM_PROVIDER=ollama
GREYBOX_OLLAMA_URL=http://host.docker.internal:11434
GREYBOX_OLLAMA_MODEL=llama3.2

GREYBOX_OPENAI_API_KEY=
GREYBOX_OPENAI_MODEL=gpt-4o-mini
